# Server Configuration
PORT=4000
WEB_ORIGIN=http://localhost:3000

# Rate Limiting (optional, defaults shown below)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=100

# Admin panel — bearer token the polypad-admin app authenticates with to read
# room data from GET /admin/rooms. Required for that endpoint to work at all;
# generate a long random value, e.g. `openssl rand -base64 32`.
# ADMIN_API_TOKEN=
